{
  "apiVersion": "v1.2",
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "Xunji",
            "description": "Xunji - save any link, find it again by memory.",
            "color": "#A0432E",
            "region": "asia-east",
            "networking": {
              "allowedIngressProjects": []
            }
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "Addon",
                "ref": "db",
                "spec": {
                  "name": "xunji-db",
                  "type": "postgresql",
                  "version": "16",
                  "billing": {
                    "deploymentPlan": "nf-compute-50",
                    "storage": 6144,
                    "replicas": 1
                  },
                  "tlsEnabled": true,
                  "externalAccessEnabled": false
                }
              },
              {
                "kind": "BuildService",
                "ref": "backend",
                "spec": {
                  "name": "xunji-backend",
                  "billing": {
                    "buildPlan": "nf-compute-400-16"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectType": "github",
                    "projectUrl": "https://github.com/wst7/xunji"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "buildkit",
                      "dockerWorkDir": "/backend",
                      "dockerFilePath": "/backend/Dockerfile",
                      "buildkit": {
                        "useCache": true,
                        "cacheStorageSize": 16384
                      }
                    }
                  }
                }
              },
              {
                "kind": "Build",
                "ref": "backendbuild",
                "spec": {
                  "id": "${refs.backend.id}",
                  "type": "service",
                  "branch": "main"
                }
              },
              {
                "kind": "Workflow",
                "spec": {
                  "type": "parallel",
                  "steps": [
                    {
                      "kind": "Condition",
                      "spec": {
                        "kind": "Addon",
                        "spec": {
                          "type": "running",
                          "data": {
                            "addonId": "${refs.db.id}",
                            "timeoutDuration": 1800
                          }
                        }
                      }
                    },
                    {
                      "kind": "Condition",
                      "spec": {
                        "kind": "Build",
                        "spec": {
                          "type": "success",
                          "data": {
                            "buildId": "${refs.backendbuild.id}"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "kind": "SecretGroup",
                "ref": "env",
                "spec": {
                  "name": "xunji-env",
                  "type": "secret",
                  "secretType": "environment",
                  "priority": 10,
                  "restrictions": {
                    "restricted": false,
                    "nfObjects": [],
                    "tags": []
                  },
                  "secrets": {
                    "variables": {
                      "APP_SECRET": "${fn.randomSecret(64)}",
                      "LOG_LEVEL": "INFO",
                      "AI_PROVIDER": "extractive",
                      "EMBEDDING_PROVIDER": "local",
                      "EMBEDDING_DIM": "1536"
                    },
                    "files": {}
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.db.id}",
                      "keys": [
                        {
                          "keyName": "POSTGRES_URI",
                          "aliases": [
                            "DATABASE_URL"
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "kind": "DeploymentService",
                "ref": "api",
                "spec": {
                  "name": "xunji-api",
                  "billing": {
                    "deploymentPlan": "nf-compute-50"
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": {
                      "configType": "default"
                    },
                    "internal": {
                      "id": "${refs.backend.id}",
                      "branch": "main",
                      "buildId": "${refs.backendbuild.id}"
                    }
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 8000,
                      "protocol": "HTTP",
                      "public": false,
                      "vpcAccessible": false
                    }
                  ]
                }
              },
              {
                "kind": "DeploymentService",
                "ref": "worker",
                "spec": {
                  "name": "xunji-worker",
                  "billing": {
                    "deploymentPlan": "nf-compute-50"
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": {
                      "configType": "customCommand",
                      "customCommand": "python -m app.workers.runner"
                    },
                    "internal": {
                      "id": "${refs.backend.id}",
                      "branch": "main",
                      "buildId": "${refs.backendbuild.id}"
                    }
                  }
                }
              },
              {
                "kind": "CombinedService",
                "ref": "web",
                "spec": {
                  "name": "xunji-web",
                  "billing": {
                    "deploymentPlan": "nf-compute-20",
                    "buildPlan": "nf-compute-400-16"
                  },
                  "buildSource": "git",
                  "vcsData": {
                    "projectType": "github",
                    "projectUrl": "https://github.com/wst7/xunji",
                    "projectBranch": "main"
                  },
                  "buildSettings": {
                    "dockerfile": {
                      "buildEngine": "buildkit",
                      "dockerWorkDir": "/",
                      "dockerFilePath": "/apps/web/Dockerfile",
                      "buildkit": {
                        "useCache": true,
                        "cacheStorageSize": 16384
                      }
                    }
                  },
                  "deployment": {
                    "instances": 1,
                    "docker": {
                      "configType": "default"
                    }
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 80,
                      "protocol": "HTTP",
                      "public": true,
                      "vpcAccessible": false
                    }
                  ],
                  "runtimeEnvironment": {
                    "API_UPSTREAM": "http://xunji-api:8000"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
