# 仓库根为构建上下文时，忽略本机依赖、构建产物与内部工具目录。
# node_modules 在镜像内由 npm ci 重新安装；apps/mobile 不参与 Web / landing 构建。
node_modules/
**/node_modules/

dist/
**/dist/

# Expo 生成的原生工程与缓存（移动端不走 Docker）
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/
apps/mobile/dist/

# 本地密钥与环境文件
.env
.env.*
!.env.example

# 本地数据库、工具与运行时产物
ruvector.db
.ruvector/
mcp-memory.db
.claude-flow/
.swarm/
.agents/
.claude/
.mcp.json
skills-lock.json

# 版本控制与系统文件
.git/
.gitignore
.DS_Store
*.log
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
backend/.venv/
