# 拾回配置示例：复制为 .env 并按需修改。禁止把密钥提交进 Git。

# --- 基础 ---
DATABASE_URL=postgresql+psycopg://recall:recall@localhost:5432/recall
APP_SECRET=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# --- AI 摘要（extractive = 本地抽取式；openai / openai-compatible = 任意 OpenAI 兼容接口）---
AI_PROVIDER=extractive
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# 兼容层细节：默认值适配 OpenAI；中转站、个人服务商、Ollama、vLLM 按需修改。
# AI_CHAT_PATH=/chat/completions
# AI_AUTH_HEADER=Authorization
# AI_AUTH_PREFIX=Bearer          # 留空表示直接发送 key，如 X-Api-Key: sk-xxx
# AI_EXTRA_HEADERS={}            # JSON 对象，例如 {"X-Title":"Shihui"}
# AI_JSON_MODE=true              # 服务商不支持 response_format 时设为 false
# AI_TIMEOUT_SECONDS=60

# 示例：OpenRouter（聚合多家模型）
# AI_PROVIDER=openai-compatible
# AI_API_KEY=sk-or-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat
# AI_EXTRA_HEADERS={"X-Title":"Shihui"}

# 示例：硅基流动 / 其他个人服务商
# AI_PROVIDER=openai-compatible
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 示例：本地 Ollama（无密钥，通常也不支持 JSON mode）
# AI_PROVIDER=openai-compatible
# AI_API_KEY=
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5:7b
# AI_JSON_MODE=false

# --- Embedding（openai / openai-compatible = 兼容 /embeddings；local = 本地特征哈希向量）---
# 注意：维度必须等于 EMBEDDING_DIM，否则启动即报错。
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# 兼容层细节，含义同 AI_* 对应项。
# EMBEDDING_PATH=/embeddings
# EMBEDDING_AUTH_HEADER=Authorization
# EMBEDDING_AUTH_PREFIX=Bearer
# EMBEDDING_EXTRA_HEADERS={}
# EMBEDDING_TIMEOUT_SECONDS=60

# --- 抓取安全 ---
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5
FETCH_ALLOWED_PORTS=80,443,8080,8443

# --- 切分 ---
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150

# --- 搜索融合权重（候选集内归一化后加权）---
SEARCH_LEXICAL_WEIGHT=0.35
SEARCH_SEMANTIC_WEIGHT=0.35
SEARCH_TITLE_WEIGHT=0.20
SEARCH_META_WEIGHT=0.10
SEARCH_MIN_SCORE=0.05
SEARCH_VECTOR_CANDIDATES=50

# --- 后台任务 ---
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3

# --- 会话 ---
TOKEN_TTL_DAYS=30
